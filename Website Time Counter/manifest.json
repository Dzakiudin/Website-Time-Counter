{
  "manifest_version": 3,
  "name": "Website Time Counter",
  "version": "1.0",
  "description": "Hitung total waktu yang dihabiskan di setiap situs hari ini. BY JAKIJEKI",
  "permissions": [
    "tabs",
    "storage",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
